{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.dibar;
  inherit (lib)
    mkEnableOption
    mkIf
    mkOption
    types
    ;

  qmlBool = value: if value then "true" else "false";
  qmlValue = value: builtins.toJSON value;

  settingsFile = pkgs.writeText "dibar-settings.qml" ''
    pragma Singleton

    import QtQuick

    QtObject {
        // Optional features
        readonly property bool enableApplicationLauncher: ${qmlBool cfg.settings.enableApplicationLauncher}
        readonly property bool enableClipboard: ${qmlBool cfg.settings.enableClipboard}
        readonly property bool enablePowerMenu: ${qmlBool cfg.settings.enablePowerMenu}
        readonly property bool enablePowerProfiles: ${qmlBool cfg.settings.enablePowerProfiles}
        readonly property bool enablePolkit: ${qmlBool cfg.settings.enablePolkit}
        readonly property bool enableExternalBrightness: ${qmlBool cfg.settings.enableExternalBrightness}

        // Displays
        readonly property string internalMonitorName: ${qmlValue cfg.settings.internalMonitorName}

        // Interface
        readonly property real uiScale: ${toString cfg.settings.uiScale}

        // Transient island feedback
        readonly property bool enableVolumeFeedback: ${qmlBool cfg.settings.enableVolumeFeedback}
        readonly property bool enableBrightnessFeedback: ${qmlBool cfg.settings.enableBrightnessFeedback}
        readonly property bool enableWorkspaceFeedback: ${qmlBool cfg.settings.enableWorkspaceFeedback}

        // Application launcher
        readonly property var terminalCommand: ${qmlValue cfg.settings.terminalCommand}

        // System controls
        readonly property var lockCommand: ${qmlValue cfg.settings.lockCommand}
        readonly property real maximumVolume: ${toString cfg.settings.maximumVolume}
        readonly property real brightnessStep: ${toString cfg.settings.brightnessStep}
    }
  '';

  package = pkgs.callPackage ./package.nix { inherit settingsFile; };
in
{
  options.programs.dibar = {
    enable = mkEnableOption "DIBAR, a Dynamic Island-style shell for Hyprland";

    package = mkOption {
      type = types.package;
      readOnly = true;
      default = package;
      description = "The configured DIBAR package generated by this module.";
    };

    extraPackages = mkOption {
      type = types.listOf types.package;
      default = [ ];
      example = lib.literalExpression "[ pkgs.ghostty ]";
      description = "Additional runtime tools to install alongside DIBAR.";
    };

    systemd.enable = mkEnableOption "automatic startup through a user service";

    settings = {
      enableApplicationLauncher = mkOption {
        type = types.bool;
        default = true;
      };

      enableClipboard = mkOption {
        type = types.bool;
        default = true;
      };

      enablePowerMenu = mkOption {
        type = types.bool;
        default = true;
      };

      enablePowerProfiles = mkOption {
        type = types.bool;
        default = true;
      };

      enablePolkit = mkOption {
        type = types.bool;
        default = true;
      };

      enableExternalBrightness = mkOption {
        type = types.bool;
        default = true;
      };

      internalMonitorName = mkOption {
        type = types.str;
        default = "eDP-1";
      };

      uiScale = mkOption {
        type = types.number;
        default = 1.0;
      };

      enableVolumeFeedback = mkOption {
        type = types.bool;
        default = true;
      };

      enableBrightnessFeedback = mkOption {
        type = types.bool;
        default = true;
      };

      enableWorkspaceFeedback = mkOption {
        type = types.bool;
        default = false;
      };

      terminalCommand = mkOption {
        type = types.listOf types.str;
        default = [
          "ghostty"
          "-e"
        ];
      };

      lockCommand = mkOption {
        type = types.listOf types.str;
        default = [ "hyprlock" ];
      };

      maximumVolume = mkOption {
        type = types.number;
        default = 1.5;
      };

      brightnessStep = mkOption {
        type = types.number;
        default = 0.05;
      };
    };
  };

  config = mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.settings.uiScale >= 0.5;
        message = "programs.dibar.settings.uiScale must be at least 0.5.";
      }
      {
        assertion = cfg.settings.maximumVolume > 0;
        message = "programs.dibar.settings.maximumVolume must be greater than zero.";
      }
      {
        assertion = cfg.settings.brightnessStep > 0 && cfg.settings.brightnessStep <= 1;
        message = "programs.dibar.settings.brightnessStep must be between 0 and 1.";
      }
    ];

    home.packages = [
      cfg.package
      pkgs.brightnessctl
    ]
    ++ lib.optionals cfg.settings.enableExternalBrightness [ pkgs.ddcutil ]
    ++ lib.optionals cfg.settings.enableClipboard [
      pkgs.cliphist
      pkgs.wl-clipboard
    ]
    ++ lib.optionals (cfg.settings.lockCommand == [ "hyprlock" ]) [ pkgs.hyprlock ]
    ++ cfg.extraPackages;

    systemd.user.services.dibar = mkIf cfg.systemd.enable {
      Unit = {
        Description = "DIBAR Quickshell shell";
        PartOf = [ "graphical-session.target" ];
        After = [ "graphical-session.target" ];
      };

      Service = {
        ExecStart = lib.getExe cfg.package;
        Restart = "on-failure";
        RestartSec = 2;
      };

      Install.WantedBy = [ "graphical-session.target" ];
    };
  };
}
